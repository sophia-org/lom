// Minimal's colors and spacing, expressed as typed styles rather than GTK CSS.
version 1
theme "minimal" {
    defaults {
        background "#1c1c1c"
        selected "#2d2d2d"
        foreground "#ffffff"
        active "#6699cc"
        urgent "#8f0a0a"
        font-size 13
        gap 13
        padding 7
    }
    module "clock" {
        bold #true
    }
}
